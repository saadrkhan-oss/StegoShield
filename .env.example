# ============================================
# StegoShield - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env

# Flask Secret Key (CHANGE THIS! Use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key

# Admin Registration Key (users enter this to register as admin)
ADMIN_KEY=STEGO_ADMIN_2024

# Database URL (default: SQLite, for production use PostgreSQL)
# SQLite:     sqlite:///stego.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///stego.db

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=0

# External Tool Paths (adjust for your server OS)
EXIFTOOL_PATH=exiftool
CLAMAV_PATH=clamscan
BINWALK_CMD=binwalk
ZSTEG_CMD=zsteg
